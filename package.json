{
  "name": "npubcash",
  "workspaces": [
    "./packages/*"
  ],
  "scripts": {
    "build": "ROOT_DIR=$(pwd) bun run --filter '*' build",
    "dev": "ROOT_DIR=$(pwd) bun run --filter '!@npubcash-env' dev",
    "setup": "ROOT_DIR=$(pwd) node dist/env/index.js",
    "start": "ROOT_DIR=$(pwd) node dist/server/index.cjs"
  }
}
