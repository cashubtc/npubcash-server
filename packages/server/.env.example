# Server configuration
PORT=8000
NODE_ENV=development
HOSTNAME=https://npub.cash

# Database (SQLite is default, set DATABASE_TYPE=postgres for PostgreSQL)
DATABASE_TYPE=sqlite
DATABASE_URL=./data.db

# Required: Mint URL for default cashu mint
MINTURL=https://mint.example.com

# API mode: BOTH (default) or API_ONLY
API_MODE=BOTH

# Logging: info (default) or debug
LOG_LEVEL=info

# Authentication: Provide either MNEMONIC or both JWT_SECRET and ZAP_SECRET_KEY
# MNEMONIC derives both secrets - use comma-separated words
MNEMONIC=word1,word2,word3,word4,word5,word6,word7,word8,word9,word10,word11,word12
# Or set secrets directly:
# JWT_SECRET=your-jwt-secret-hex
# ZAP_SECRET_KEY=your-nostr-secret-key-hex

# Nostr configuration (optional)
# NOSTR_ENABLED=true
# DEFAULT_RELAYS=wss://relay.damus.io,wss://nos.lol

# LNURL limits (in millisatoshis)
# LNURL_MIN_AMOUNT=1000
# LNURL_MAX_AMOUNT=100000000

# Username purchases (optional)
# USERNAME_MINT=https://mint.example.com
# USERNAME_COST=1000
