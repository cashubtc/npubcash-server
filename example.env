# Required server configuration
MINTURL=https://mint.example
JWT_SECRET=

# Production database: use a PostgreSQL URL, a SQLite file path, or explicitly
# select SQLite to use /data/npubcash.db when DATABASE_URL is omitted.
# DATABASE_URL=postgresql://user:password@host:5432/npubcash
DATABASE_TYPE=sqlite

# Public request handling
NODE_ENV=development
ALLOWED_HOSTNAMES=localhost
API_MODE=BOTH
PORT=8000
LOG_LEVEL=info

# LNURL limits in millisatoshis
LNURL_MIN_AMOUNT=1000
LNURL_MAX_AMOUNT=100000000

# Optional paid or free username registration. Both values are required to
# enable the feature; USERNAME_COST may be zero.
# USERNAME_MINT=https://mint.example
# USERNAME_COST=5000

# Optional Nostr zap support. When enabled, configure relays and either a
# 32-byte hex ZAP_SECRET_KEY or MNEMONIC. MNEMONIC can also replace JWT_SECRET.
# NOSTR_ENABLED=true
# DEFAULT_RELAYS=wss://relay.damus.io,wss://relay.primal.net
# ZAP_SECRET_KEY=
# MNEMONIC=word1,word2,word3

# Mint quote monitoring
MINT_QUOTE_ACTIVE_POLL_MS=20000
MINT_QUOTE_REQUEST_TIMEOUT_MS=10000
MINT_QUOTE_RATE_LIMIT_CAPACITY=1
MINT_QUOTE_RATE_LIMIT_REFILL_PER_MINUTE=20
MINT_QUOTE_WS_RECONNECT_MS=180000

# Deprecated rollback-only settings; parsed but ignored by the current runtime.
# MINT_QUOTE_ACTIVE_RETRY_MS=5000,10000,30000,60000
# MINT_QUOTE_RECONCILIATION_RETRY_MS=60000,300000,1800000,7200000,21600000
# MINT_QUOTE_RETRY_JITTER_RATIO=0.2
